# Auto detect text files and perform LF normalization
* text=auto

# 显式锁定：脚本/配置/文档一律 LF，避免 Windows 下克隆后 CRLF 导致
# "bash: $'\r': command not found" 这类只在别人机器上出现的故障（v1.0.0 实测踩到）。
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ioc  text eol=lf
*.mx   text eol=lf

# CubeMX 生成的二进制/产物不做行尾转换
*.bin  binary
*.elf  binary
*.hex  binary
*.zip  binary
